<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KWEZAP — User Dashboard</title>
  <link rel="stylesheet" href="/vendor/normalize-4.1.1.css" type="text/css" />
  <link rel="stylesheet" href="/vendor/border-box.css" type="text/css" />
  <link rel="stylesheet" href="/styles/main.css" type="text/css" />
  <link rel="stylesheet" href="/styles/layout.css" type="text/css" />
  <script type="text/javascript" src="/vendor/jquery-3.0.0.js"></script>
  <script type="text/javascript" src="/scripts/app.js"></script>
</head>

<body>
  <header class="site-header">
    <nav class="navbar">
      <a href="/home/<%= user_id %>" class="brand">KWEZAP</a>
      <div class="nav-links">
        <a href="/home/<%= user_id %>" class="nav-btn">Explore Quizzes</a>
        <a href="/users/<%= user_id %>" class="nav-btn">My Dashboard</a>
        <a href="/users/createquiz/<%= user_id %>" class="nav-btn primary">+ Create Quiz</a>
      </div>
    </nav>
  </header>

  <div class="main-container">
    <div class="hero-card">
      <h1>Welcome, <%= user ? user.username : ('User #' + user_id) %>!</h1>
      <p class="subtitle">Manage your quizzes, control privacy settings, and share your quiz links or recent scores.</p>
      <a href="/users/createquiz/<%= user_id %>" class="btn primary">+ Create a New Quiz</a>
    </div>

    <h2 class="section-title">Your Created Quizzes (<%= userInfo.length %>)</h2>
    <% if (userInfo.length > 0) { %>
      <div class="links-container">
        <% for (let quiz of userInfo) { %>
          <div class="quiz-card">
            <div class="quiz-card-body">
              <div class="quiz-meta">
                <span class="badge <%= quiz.public ? 'badge-public' : 'badge-private' %>">
                  <%= quiz.public ? 'Public' : 'Private (Unlisted)' %>
                </span>
                <span class="badge"><%= quiz.question_count || 0 %> Questions</span>
              </div>
              <h3><a href="/quiz/<%= quiz.id %>"><%= quiz.title %></a></h3>
              <p><%= quiz.description %></p>
            </div>
            <div class="quiz-card-actions">
              <a href="/quiz/<%= quiz.id %>" class="btn primary">Take / View</a>
              <a href="/quiz/<%= quiz.id %>/questions" class="btn secondary">+ Question</a>
              <button type="button" class="btn secondary copy-link-btn" data-url="/quiz/<%= quiz.id %>">Share Quiz</button>
              <form method="POST" action="/users/<%= user_id %>/visibility/<%= quiz.id %>" class="inline-form">
                <button class="btn secondary" type="submit">
                  Make <%= quiz.public ? 'Private' : 'Public' %>
                </button>
              </form>
              <form method="POST" action="/users/<%= user_id %>/delete/<%= quiz.id %>" class="inline-form">
                <button class="btn danger" type="submit">Delete</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>You haven't created any quizzes yet.</p>
        <a href="/users/createquiz/<%= user_id %>" class="btn primary">Create Your First Quiz</a>
      </div>
    <% } %>

    <h2 class="section-title">Your Recent Quiz Results (<%= (attempts && attempts.length) || 0 %>)</h2>
    <% if (attempts && attempts.length > 0) { %>
      <div class="links-container">
        <% for (let att of attempts) { %>
          <div class="quiz-card">
            <div class="quiz-card-body">
              <div class="quiz-meta">
                <span class="badge badge-score">Score: <%= att.score %> / <%= att.total_questions || '?' %></span>
              </div>
              <h3><a href="/attempts/<%= att.attempt_id %>"><%= att.title %></a></h3>
            </div>
            <div class="quiz-card-actions">
              <a href="/attempts/<%= att.attempt_id %>" class="btn primary">View Result</a>
              <button type="button" class="btn secondary copy-link-btn" data-url="/attempts/<%= att.attempt_id %>">Share Result</button>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No quiz attempts recorded yet. Try taking a quiz!</p>
      </div>
    <% } %>
  </div>
</body>

</html>
