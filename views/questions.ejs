<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KWEZAP — Add Question</title>

  <link rel="stylesheet" href="/vendor/normalize-4.1.1.css" type="text/css" />
  <link rel="stylesheet" href="/vendor/border-box.css" type="text/css" />
  <link rel="stylesheet" href="/styles/main.css" type="text/css" />
  <link rel="stylesheet" href="/styles/layout.css" type="text/css" />
  <script type="text/javascript" src="/vendor/jquery-3.0.0.js"></script>
  <script type="text/javascript" src="/scripts/app.js"></script>
</head>

<body>
  <header class="site-header">
    <nav class="navbar">
      <a href="/" class="brand">KWEZAP</a>
      <div class="nav-links">
        <a href="/" class="nav-btn">Explore Quizzes</a>
        <% if (currentUser) { %>
          <a href="/users/<%= currentUser.id %>" class="nav-btn">My Dashboard</a>
          <a href="/quiz/<%= quizId %>" class="nav-btn">View Quiz</a>
        <% } else { %>
          <a href="/auth/login" class="nav-btn">Login</a>
        <% } %>
      </div>
    </nav>
  </header>

  <div class="main-container">
    <div class="form-card create-question-cont">
      <h2>Add a Question<%= typeof quiz !== 'undefined' && quiz ? ' to "' + quiz.title + '"' : '' %></h2>

      <% if (typeof existingQuestions !== 'undefined' && existingQuestions.length > 0) { %>
        <p class="subtitle">Questions added so far: <strong><%= existingQuestions.length %></strong></p>
      <% } %>

      <form id="quiz-question" method="POST" action="/quiz/<%= quizId %>/questions">
        <div class="form-group">
          <label for="question-text">Question Prompt</label>
          <input id="question-text" type="text" name="question" placeholder="Enter your question..." required />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn primary">Next: Add Answer Choices</button>
          <a href="/quiz/<%= quizId %>" class="btn secondary">Finish & View Quiz</a>
        </div>
      </form>
    </div>
  </div>
</body>

</html>
